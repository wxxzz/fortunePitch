# FortunePitch 后端环境配置模板
# 复制为 .env 并填入真实值:cp .env.example .env

# MySQL 数据库连接
# 注意:密码中的特殊字符需做 URL 编码(# -> %23,$ -> %24,@ -> %40)
DATABASE_URL=mysql+aiomysql://root:your_password@8.163.65.51:3306/fortunePitch?charset=utf8mb4

# 接口访问凭证(生产环境必须替换)
API_KEY=change-me-in-production

# 大模型分析:服务商 qwen=阿里云百炼 / ark=火山方舟
# 千问默认模型 qwen3.7-plus;方舟用 glm-5.2(方舟侧模型 ID 为 glm-5-2-260617)
LLM_PROVIDER=qwen
LLM_QWEN_API_KEY=sk-your-qwen-api-key
LLM_ARK_API_KEY=ark-your-ark-api-key
